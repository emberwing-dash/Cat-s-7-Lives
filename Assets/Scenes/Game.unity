  m_Name: 
  m_EditorClassIdentifier: CatOnTheSill::CatOnTheSill.SensorPuzzle
  id: p6
  fragmentIndex: 5
  title: The False Reflection
  roomName: Sunroom
  roomBounds:
    m_Center: {x: 15, y: 3.3, z: 9}
    m_Extent: {x: 3, y: 4, z: 3}
  hints:
  - Three stained-glass slits throw coloured beams across this room at sunrise. Not
    every glittering path leads anywhere.
  - 'Only the gold beam matters. The mirrors on their stands can be turned (E / Q):
    the near one passes the beam to the far one, the far one to the west wall.'
  - Turn the near mirror until the gold line crosses to the far mirror, then turn
    the far mirror until the line reaches the faint diamond carving low on the west
    wall. The red lanterns are decoys.
  revealPos: {x: 12.7, y: 1.8872516, z: 9.686272}
  hasLand: 1
  landPosition: {x: 12.9, y: 0.75, z: 9.686272}
  cabinet: {fileID: 0}
  requiredHold: 0.45
  autoReveal: 1
  sensors:
