  m_Name: 
  m_EditorClassIdentifier: CatOnTheSill::CatOnTheSill.SensorPuzzle
  id: p3
  fragmentIndex: 2
  title: The Silver Tray
  roomName: Kitchen
  roomBounds:
    m_Center: {x: 15, y: 1.5, z: 3}
    m_Extent: {x: 3, y: 2, z: 3}
  hints:
  - Something shiny in this kitchen can throw light where light does not usually
    go.
  - The silver tray catches the window's beam. Turn it with E / Q and slide it along
    the table until a bright line points at the glass star on the high cupboard.
  - Light bounces off the tray at the same angle it arrives. Stand the tray in the
    sunlit patch (the beam only reaches the west end of the table) and turn it toward
    the east wall.
  revealPos: {x: 17.6, y: 1.8044, z: 2.3397005}
  hasLand: 1
  landPosition: {x: 17.4, y: 1.28, z: 2.3397005}
  cabinet: {fileID: 478202800}
  requiredHold: 0.9
  autoReveal: 1
  sensors:
