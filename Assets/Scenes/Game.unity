  m_Name: 
  m_EditorClassIdentifier: CatOnTheSill::CatOnTheSill.GlyphPuzzle
  id: p5
  fragmentIndex: 4
  title: The Moving Moon
  roomName: Attic
  roomBounds:
    m_Center: {x: 15, y: 3.9, z: 10.7}
    m_Extent: {x: 3, y: 1.7, z: 1.3}
  hints:
  - The moon does not stay put. Open the shutters on the round window (pull the cord)
    and watch where its light lands as the night wears on.
  - A hanging silver moon casts a shadow that wanders across the floor. A pale ring
    is carved where the shadow stops - but only at one hour.
  - Carry the little basin onto the carved ring, set the clock to Midnight, and let
    the moon-star's shadow fall across it.
  revealPos: {x: 15.947994, y: 3.2, z: 11.186311}
  hasLand: 1
  landPosition: {x: 15.947994, y: 3.08, z: 11.186311}
